# Local development values. Set production values in the frontend hosting
# platform's environment settings; never commit real OAuth credentials.
# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-key-32-chars-min

# Google OAuth Credentials (configured in Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Backend API base URL, including /api. Set to the public HTTPS backend URL
# in production.
NEXT_PUBLIC_API_URL=http://localhost:4000/api
