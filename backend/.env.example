# Server Configuration
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:3000
GOOGLE_CLIENT_ID=
ADMIN_EMAILS=

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/email_scheduler?schema=public"

# Redis Configuration (BullMQ & Distributed Rate Limiting)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# SMTP Configuration (Ethereal Email for dev/testing)
# Can be generated automatically or set manually via https://ethereal.email
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
SMTP_FROM=no-reply@outbox.local

# Worker & Scheduling Defaults
MAX_EMAILS_PER_HOUR=200
DEFAULT_HOURLY_LIMIT=200
DELAY_BETWEEN_EMAILS_MS=2000
DEFAULT_EMAIL_DELAY_MS=2000
WORKER_CONCURRENCY=5
ATTACHMENT_STORAGE_DIR=./storage/attachments

# Slack OAuth and encrypted token storage
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:4000/api/slack/callback
SLACK_SUCCESS_REDIRECT=http://localhost:3000/dashboard
SLACK_TOKEN_ENCRYPTION_KEY=

# Optional Elasticsearch search index
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_API_KEY=
ELASTICSEARCH_INDEX=outbox-emails
