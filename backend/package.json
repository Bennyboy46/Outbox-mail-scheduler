{
  "name": "backend",
  "version": "1.0.0",
  "description": "Backend Email Scheduler Service with BullMQ, Redis, PostgreSQL, and Ethereal SMTP",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "worker": "tsx watch src/worker.ts",
    "build": "tsc",
    "test": "vitest run",
    "start": "node dist/index.js",
    "start:worker": "node dist/worker.js",
    "migrate:deploy": "prisma migrate deploy",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "elasticsearch:reindex": "tsx src/scripts/reindexEmails.ts"
  },
  "dependencies": {
    "@bull-board/api": "^9.10.2",
    "@bull-board/express": "^9.10.2",
    "@elastic/elasticsearch": "^9.5.1",
    "@prisma/client": "^5.22.0",
    "@slack/oauth": "^4.0.0",
    "@slack/web-api": "^8.1.1",
    "@types/multer": "^2.3.0",
    "bullmq": "^5.41.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "google-auth-library": "^11.1.0",
    "ioredis": "^5.4.2",
    "multer": "^2.4.0",
    "nodemailer": "^6.10.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.4",
    "@types/nodemailer": "^6.4.17",
    "prisma": "^5.22.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^5.0.2"
  }
}
